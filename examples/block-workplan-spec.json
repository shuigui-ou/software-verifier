{
  "app": "积木计划工作台 (block-workplan)",
  "features": [
    {
      "id": "F01",
      "name": "载入示例（委托单→测试类型→工步 三层）",
      "type": "ui",
      "group": "基础",
      "setup": [
        {
          "do": "exec",
          "js": "(()=>{ try{ if(typeof loadSample==='function'){ loadSample(); } }catch(e){} })()"
        },
        {
          "do": "waitSel",
          "sel": ".block-card",
          "timeout": 8000
        }
      ],
      "steps": [],
      "asserts": [
        {
          "eval": "document.querySelectorAll('.block-card').length >= 3",
          "desc": "示例已铺出 >=3 个积木卡"
        },
        {
          "eval": "!!(function(){ var s=[].slice.call(document.querySelectorAll('.sort-no')).map(function(e){return e.textContent.trim();}); return s.some(function(t){return /^\\d+\\.\\d+$/.test(t);}); })()",
          "desc": "存在层级式编号如 1.1"
        }
      ]
    },
