    {
      "id": "F05",
      "name": "库内组合（绑成组合并拉取）",
      "type": "ui",
      "group": "积木库",
      "setup": [
        {
          "do": "exec",
          "js": "(()=>{ try{ if(typeof loadSample==='function'){ loadSample(); } }catch(e){} })()"
        },
        {
          "do": "waitSel",
          "sel": ".block-card",
          "timeout": 8000
        },
        {
          "do": "exec",
          "js": "window.__before = document.querySelectorAll('.block-card').length;"
