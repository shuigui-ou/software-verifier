    {
      "id": "F07",
      "name": "降级/升级（层级重归属）",
      "type": "ui",
      "group": "层级",
      "setup": [
        {
          "do": "exec",
          "js": "(()=>{ try{ if(typeof loadSample==='function'){ loadSample(); } }catch(e){} })()"
        },
        {
          "do": "waitSel",
          "sel": ".block-card",
          "timeout": 8000
        },
        {
          "do": "exec",
          "js": "window.__c0 = (state.plan[0] && state.plan[0].children) ? state.plan[0].children.length : 0;"
        }
      ],
      "steps": [
        {
          "do": "clickText",
          "text": "添加同级"
        },
        {
          "do": "waitSel",
          "sel": ".preset-menu .preset-item",
          "timeout": 5000
        },
        {
          "do": "clickSel",
          "sel": ".preset-menu .preset-item",
          "nth": 0
        },
        {
          "do": "exec",
          "js": "window.__newId = (state.plan[1] && state.plan[1].id) ? state.plan[1].id : null;"
        },
        {
          "do": "exec",
          "js": "(()=>{ var id=window.__newId; if(!id) return; var card=document.querySelector('.block-card[data-id=\"'+id+'\"]'); if(!card) return; var btn=card.querySelector('[data-act=\"indent\"]'); if(btn) btn.click(); })()"
        }
      ],
      "asserts": [
        {
          "eval": "(function(){ try { return state.plan.length === 1 && state.plan[0].children.length === (window.__c0||0)+1; } catch(e){ return false; } })()",
          "desc": "降级后新块成为委托单的子级（plan[0].children 比初始多 1）"
        }
      ]
    },
