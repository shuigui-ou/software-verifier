          "do": "waitSel",
          "sel": "[data-pullcombo]",
          "timeout": 5000
        },
        {
          "do": "clickSel",
          "sel": "[data-pullcombo]",
          "nth": 0
        }
      ],
      "asserts": [
        {
          "eval": "document.querySelectorAll('.block-card').length > (window.__before||0)",
          "desc": "拉取组合后画布积木数增加"
        }
